---
export const prerender = false;

import { TAG_NAMES, TAG_SLUGS } from "../lib/admin/posts";

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Editor</title>
  </head>
  <body class="bg-white text-neutral-900">
    <header
      class="sticky top-0 z-20 flex items-center gap-3 border-b border-neutral-200 bg-white/90 px-5 py-2.5 backdrop-blur"
    >
      <a href="/admin" class="text-sm text-neutral-500 hover:text-neutral-900">← Posts</a>
      <span id="doc-title" class="ml-2 truncate text-sm font-medium">Untitled</span>
      <span id="mode-badge" class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600"></span>
      <div class="ml-auto flex items-center gap-3">
        <span id="save-state" class="text-xs text-neutral-500">Saved</span>
        <a id="view-link" target="_blank" class="text-sm text-neutral-500 hover:text-neutral-900">Preview</a>
        <button id="sidebar-toggle" type="button" class="rounded border border-neutral-300 px-3 py-1.5 text-sm">
          Settings
        </button>
        <button id="delete-btn" type="button" hidden class="rounded border border-red-300 px-3 py-1.5 text-sm text-red-700">
          Delete
        </button>
        <button id="save-btn" type="button" class="rounded bg-neutral-900 px-3 py-1.5 text-sm text-white">
          Save ⌘S
        </button>
      </div>
    </header>

    <div id="wysiwyg-wrap" class="mx-auto max-w-3xl px-6 py-12">
      <div id="editor"></div>
    </div>

    <div id="raw-wrap" hidden class="mx-auto max-w-4xl px-6 py-8">
      <p class="mb-3 rounded bg-amber-50 px-3 py-2 text-sm text-amber-900">
        This post is MDX or migrated Ghost HTML. Editing source directly so the markup is not
        rewritten.
      </p>
      <textarea
        id="raw-editor"
        spellcheck="false"
        class="h-[70vh] w-full rounded border border-neutral-300 p-4 font-mono text-sm leading-relaxed"
      ></textarea>
    </div>

    <!-- floating toolbar -->
    <div
      id="bubble"
      hidden
      class="fixed z-30 flex gap-0.5 rounded-md bg-neutral-900 p-1 text-white shadow-lg"
    >
      <button data-mark="bold" class="bubble-btn font-bold">B</button>
      <button data-mark="italic" class="bubble-btn italic">i</button>
      <button data-mark="strike" class="bubble-btn line-through">S</button>
      <button data-mark="link" class="bubble-btn">link</button>
      <button data-mark="h2" class="bubble-btn">H2</button>
      <button data-mark="h3" class="bubble-btn">H3</button>
      <button data-mark="blockquote" class="bubble-btn">"</button>
      <button data-mark="code" class="bubble-btn font-mono">&lt;/&gt;</button>
    </div>

    <!-- slash menu -->
    <div
      id="slash-menu"
      hidden
      class="fixed z-30 w-64 overflow-hidden rounded-md border border-neutral-200 bg-white py-1 shadow-xl"
    >
    </div>

    <div
      id="toast"
      hidden
      class="fixed bottom-5 left-1/2 z-40 -translate-x-1/2 rounded bg-neutral-900 px-4 py-2 text-sm text-white shadow-lg"
    >
    </div>

    <!-- settings sidebar -->
    <aside
      id="sidebar"
      class="fixed right-0 top-0 z-20 h-full w-80 translate-x-full overflow-y-auto border-l border-neutral-200 bg-white p-5 pt-16 text-sm transition-transform"
    >
      <label class="fm-label">Title</label>
      <input id="fm-title" class="fm-input" />

      <label class="fm-label">Slug</label>
      <input id="fm-slug" class="fm-input" placeholder="my-post-slug" />

      <label class="fm-label">Language</label>
      <select id="fm-lang" class="fm-input">
        <option value="zh-tw">zh-tw</option>
        <option value="en">en</option>
      </select>

      <label class="fm-label">Excerpt</label>
      <textarea id="fm-excerpt" rows="4" class="fm-input"></textarea>

      <label class="fm-label">Feature image</label>
      <div class="flex gap-2">
        <input id="fm-feature" class="fm-input flex-1" placeholder="/images/…" />
        <button id="fm-feature-pick" type="button" class="mb-3 shrink-0 rounded border border-neutral-300 px-2">
          Upload
        </button>
      </div>

      <label class="fm-label">Published at</label>
      <input id="fm-published" type="datetime-local" class="fm-input" />
      <input id="fm-created" type="hidden" />

      <label class="mb-3 flex items-center gap-2">
        <input id="fm-featured" type="checkbox" /> Featured
      </label>

      <label class="fm-label">Tags</label>
      <div class="mb-3 space-y-1">
        {
          TAG_SLUGS.map((slug) => (
            <label class="flex items-center gap-2">
              <input class="fm-tag" type="checkbox" value={slug} />
              {TAG_NAMES[slug]}
            </label>
          ))
        }
      </div>

      <label class="fm-label">Pair slug (only if it differs)</label>
      <input id="fm-pair-slug" class="fm-input" />

      <label class="fm-label">Pair lang</label>
      <select id="fm-pair-lang" class="fm-input">
        <option value="">none</option>
        <option value="zh-tw">zh-tw</option>
        <option value="en">en</option>
      </select>
    </aside>

    <style is:global>
      [hidden] {
        display: none !important;
      }
      .fm-label {
        @apply mb-1 block text-xs font-medium uppercase tracking-wide text-neutral-500;
      }
      .fm-input {
        @apply mb-3 w-full rounded border border-neutral-300 px-2 py-1.5 text-sm;
      }
      .bubble-btn {
        @apply rounded px-2 py-1 text-sm hover:bg-neutral-700;
      }
      .bubble-btn.is-active {
        @apply bg-white text-neutral-900;
      }
      #sidebar.is-open {
        transform: translateX(0);
      }
      .slash-item {
        @apply flex w-full items-center justify-between px-3 py-2 text-left text-sm hover:bg-neutral-100;
      }
      .slash-item.is-active {
        @apply bg-neutral-100;
      }
      .slash-item em {
        @apply not-italic text-xs text-neutral-400;
      }
      .ProseMirror {
        min-height: 60vh;
      }
      .ProseMirror:focus {
        outline: none;
      }
      .ProseMirror p.is-editor-empty:first-child::before {
        content: attr(data-placeholder);
        float: left;
        height: 0;
        pointer-events: none;
        @apply text-neutral-400;
      }
      .ProseMirror img {
        @apply rounded;
      }
      .ProseMirror .ProseMirror-selectednode {
        @apply outline outline-2 outline-neutral-900;
      }
    </style>

    <script>
      import { initEditor } from "../scripts/admin/editor";
      initEditor();
    </script>
  </body>
</html>
