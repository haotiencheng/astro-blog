---
export const prerender = false;

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Posts · Editor</title>
  </head>
  <body class="bg-neutral-50 text-neutral-900">
    <header class="sticky top-0 z-10 flex items-center gap-3 border-b border-neutral-200 bg-white px-6 py-3">
      <h1 class="text-lg font-semibold">Posts</h1>
      <input
        id="filter"
        type="search"
        placeholder="Filter…"
        class="ml-4 w-64 rounded border border-neutral-300 px-3 py-1.5 text-sm"
      />
      <div class="ml-auto flex gap-2">
        <a href="/admin/edit?lang=zh-tw" class="rounded bg-neutral-900 px-3 py-1.5 text-sm text-white">New zh-tw</a>
        <a href="/admin/edit?lang=en" class="rounded bg-neutral-900 px-3 py-1.5 text-sm text-white">New en</a>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-8">
      <div id="list" class="space-y-2 text-sm text-neutral-500">Loading…</div>
    </main>

    <script>
      type Post = {
        lang: string;
        slug: string;
        ext: string;
        mode: string;
        title: string;
        excerpt: string;
        featured: boolean;
        published_at: string;
        file: string;
      };

      const list = document.getElementById("list")!;
      const filter = document.getElementById("filter") as HTMLInputElement;
      let posts: Post[] = [];

      function render() {
        const q = filter.value.toLowerCase();
        const rows = posts.filter(
          (p) => !q || p.title.toLowerCase().includes(q) || p.slug.includes(q),
        );
        list.innerHTML = rows
          .map(
            (p) => `
          <a href="/admin/edit?lang=${p.lang}&slug=${p.slug}"
             class="flex items-center gap-3 rounded border border-neutral-200 bg-white px-4 py-3 hover:border-neutral-400">
            <span class="w-14 shrink-0 rounded bg-neutral-100 px-2 py-0.5 text-center text-xs text-neutral-600">${p.lang}</span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-medium text-neutral-900">${p.title}</span>
              <span class="block truncate text-xs text-neutral-500">${p.slug}</span>
            </span>
            ${p.mode === "raw" ? `<span class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-800">source</span>` : ""}
            ${p.featured ? `<span class="rounded bg-emerald-100 px-2 py-0.5 text-xs text-emerald-800">featured</span>` : ""}
            <span class="w-24 shrink-0 text-right text-xs text-neutral-500">${(p.published_at || "").slice(0, 10)}</span>
          </a>`,
          )
          .join("");
        if (!rows.length) list.innerHTML = `<p class="text-neutral-500">No posts match.</p>`;
      }

      filter.addEventListener("input", render);

      fetch("/api/admin/posts")
        .then((r) => r.json() as Promise<{ posts: Post[] }>)
        .then((d: { posts: Post[] }) => {
          posts = d.posts;
          render();
        });
    </script>
  </body>
</html>
