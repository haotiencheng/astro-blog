---
interface Props {
  lang: "zh-tw" | "en";
}

const { lang } = Astro.props;
const en = lang === "en";

const t = {
  heading: en ? "Projects" : "專案",
  intro: en
    ? "Things I build and run as an indie developer. Open for discussions and business collaboration."
    : "身為獨立開發者做的產品與工具。歡迎各式討論、商業合作。",
  contact: en ? "Contact me" : "聯繫我",
  visit: en ? "Visit" : "前往",
};

const projects = [
  {
    name: "Mocky.pro",
    url: "https://mocky.pro?ref=reallyniceday.com",
    icon: "/images/projects/mocky-icon.png",
    description: en
      ? "An English mock interview platform for Chinese speakers. Your training ground to conquer interview anxiety."
      : "為中文使用者打造的英文模擬面試器，一個告別面試焦慮的實戰演練場。",
  },
  {
    name: "PeekaTube",
    url: "https://www.peekatube.com?ref=reallyniceday.com",
    icon: "/images/projects/peekatube-icon.png",
    description: en
      ? "Get AI summaries of any CCed YouTube video in seconds."
      : "秒抓 YouTube 影片重點，告別標題黨。",
  },
  {
    name: "md2tg",
    url: "https://md2tg.projectstain.dev?ref=reallyniceday.com",
    icon: "/images/projects/md2tg-icon.png",
    description: en
      ? "Markdown to Telegram MarkdownV2 converter."
      : "Markdown 轉 Telegram MarkdownV2 格式的轉換工具。",
  },
];

const contactUrl = en ? "/en/contact/" : "/contact/";
---

<div class="mx-auto max-w-3xl px-4 py-10">
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight">{t.heading}</h1>
    <p class="mt-3 text-gray-600">{t.intro}</p>
    <div class="mt-4 flex items-center gap-4 text-sm">
      <a href={contactUrl} class="rounded border border-gray-900 bg-gray-900 px-3 py-1.5 text-white hover:bg-gray-700 transition-colors">{t.contact}</a>
    </div>
  </header>

  <ul class="space-y-4">
    {
      projects.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 rounded-lg border border-gray-200 p-4 hover:shadow-md transition-shadow"
          >
            <img src={p.icon} alt={p.name} width="192" height="192" loading="lazy" decoding="async" class="h-14 w-14 rounded-lg" />
            <div class="min-w-0 flex-1">
              <h2 class="font-semibold">{p.name}</h2>
              <p class="mt-1 text-sm text-gray-600">{p.description}</p>
            </div>
            <span class="hidden sm:inline text-sm text-gray-400" aria-hidden="true">{t.visit} →</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

